{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Custom Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "changelog_compiler.py",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Default Example Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "changelog_compiler.py",
            "console": "integratedTerminal",
            "args": [
                "-d",
                "-n",
                "-o", "changelog_file.txt",
                "input.yml",
            ],
        },
        {
            "name": "Only names",
            "type": "debugpy",
            "request": "launch",
            "program": "changelog_compiler.py",
            "console": "integratedTerminal",
            "args": [
                "-n",
                "input.yml",
            ],
        },
        {
            "name": "Only dates",
            "type": "debugpy",
            "request": "launch",
            "program": "changelog_compiler.py",
            "console": "integratedTerminal",
            "args": [
                "-d",
                "input.yml",
            ],
        },
        {
            "name": "No names no dates",
            "type": "debugpy",
            "request": "launch",
            "program": "changelog_compiler.py",
            "console": "integratedTerminal",
            "args": [
                "input.yml",
            ],
        },
    ]
}